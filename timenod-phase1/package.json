{
  "name": "timenod",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:employee": "npm run dev -w @timenod/employee",
    "dev:approver": "npm run dev -w @timenod/approver",
    "build": "npm run build -w @timenod/employee && npm run build -w @timenod/approver",
    "typecheck": "tsc --noEmit -p apps/employee && tsc --noEmit -p apps/approver",
    "db:generate": "drizzle-kit generate --config packages/shared/drizzle.config.ts",
    "db:migrate": "tsx --env-file=.env packages/shared/scripts/migrate.ts",
    "create-user": "tsx --env-file=.env packages/shared/scripts/create-user.ts"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
