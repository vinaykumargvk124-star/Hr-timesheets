# Copy to .env and fill in.
DATABASE_URL="postgresql://timenod:timenod@localhost:5432/timenod"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3001/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Used to build set-password links.
EMPLOYEE_SITE_URL="http://localhost:3000"
APPROVER_SITE_URL="http://localhost:3001"
